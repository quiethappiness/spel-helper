<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
	<id>io.github.quiethappiness.spel-helper</id>

	<name>SpEL Helper</name>

	<vendor url="https://github.com/quiethappiness/spel-helper">quiethappiness</vendor>

	<description><![CDATA[SpEL Helper adds syntax highlighting, code completion, and Ctrl+click navigation to SpEL expressions inside <b>custom annotations</b>.<br>
        <br>
        为自定义注解里的 SpEL 表达式提供高亮、代码补全与 Ctrl+点击跳转。<br>
        在 <b>Settings | Other Settings | SpEL Helper</b> 里配置「注解全类名 + 属性名」即可。<br>
        支持裸写 <code>#user.code</code> 与包装写法 <code>#{user.code}</code> 两种形式。<br>
        <br>
        <b>Requirements:</b> IntelliJ IDEA Ultimate 2025.2 or newer. The SpEL language is provided by the bundled Spring plugin, so the plugin cannot run in IntelliJ IDEA Community Edition.
    ]]></description>

	<depends>com.intellij.modules.platform</depends>
	<depends>com.intellij.modules.java</depends>
	<!-- SpEL 语言由 IDEA Ultimate 自带的 Spring 插件提供 -->
	<depends>com.intellij.spring</depends>

	<extensions defaultExtensionNs="com.intellij">
		<!-- 把 SpEL 注入到命中的注解属性里(高亮由 SpEL 语言自带) -->
		<multiHostInjector implementation="io.github.quiethappiness.spelhelper.inject.SpelAnnotationInjector"/>

		<!-- 注册给 SpEL 语言,并 order="first":先于 SpEL 自带的补全跑,认出上下文后 stopHere() 把它摁掉。
		     不这样做的话,列表里会混进 SpEL 按自己上下文猜出的候选(别的注解的属性名、Spring bean 等) -->
		<completion.contributor language="SpEL" order="first"
		                        implementationClass="io.github.quiethappiness.spelhelper.completion.SpelCompletionContributor"/>

		<!-- 给 #变量 / 属性 / @bean 一个能解析的引用:消除「未解析」黄线,并让跳转与查找引用变成原生行为 -->
		<psi.referenceContributor language="SpEL"
		                          implementation="io.github.quiethappiness.spelhelper.ref.SpelReferenceContributor"/>

		<!-- 兜底的 Ctrl+点击跳转(引用解析生效时不会用到) -->
		<gotoDeclarationHandler implementation="io.github.quiethappiness.spelhelper.nav.SpelGotoDeclarationHandler"/>

		<applicationService serviceImplementation="io.github.quiethappiness.spelhelper.settings.SpelHelperSettings"/>
		<applicationConfigurable id="io.github.quiethappiness.spelhelper.settings"
		                         displayName="SpEL Helper"
		                         instance="io.github.quiethappiness.spelhelper.settings.SpelHelperConfigurable"/>
	</extensions>
</idea-plugin>